            "value": "1 次连续失败"
          }
        }
      }
    },
    "1 new request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 条新请求"
          }
        }
      }
    },
    "1 probe": {
