      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问令牌"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号"
          }
        }
      }
    },
    "Add the access token in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中添加访问令牌。"
          }
        }
      }
    },
    "Add the monitor service's address in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中填写监控服务地址。"
          }
        }
      }
    },
    "Agent → magpie → Relay → %@ → Xunxin": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent → magpie → 中转 → %@ → 讯星"
          }
        }
      }
    },
    "All %lld priced": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部 %lld 条可计价"
          }
        }
      }
    },
    "All requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部请求"
          }
        }
      }
    },
    "Amount range in dollars": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金额范围（美元）"
          }
        }
      }
    },
    "An enabled connection needs a working snapshot and requests list. If live updates fail, the app saves it in polling mode and reads a snapshot every 10 seconds.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用的连接需要可用的快照和请求列表。实时更新失败时，应用会以轮询模式保存，并每 10 秒读取一次快照。"
          }
        }
      }
    },
    "Answering": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在回答"
          }
        }
      }
    },
    "Any cost": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部金额"
          }
        }
      }
    },
    "Any status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部状态"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Authentication": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鉴权方式"
          }
        }
