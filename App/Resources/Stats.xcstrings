        }
      }
    },
    "1 probe.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个探针。"
          }
        }
      }
    },
    "1 request": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 条请求"
          }
        }
      }
    },
