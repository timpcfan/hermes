          "stringUnit": {
            "state": "translated",
            "value": "%lld 条新请求"
          }
        }
      }
    },
    "%lld ok": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成功 %lld"
          }
        }
      }
    },
    "%lld probes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个探针"
          }
        }
      }
    },
    "%lld probes, none measured a latency": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个探针，均未测得延迟"
          }
        }
      }
    },
    "%lld probes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个探针。"
          }
        }
      }
    },
    "%lld requests": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条请求"
          }
        }
      }
    },
    "%lld requests · %lld ok · %lld errors · %lld canceled": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次请求 · 成功 %lld · 错误 %lld · 取消 %lld"
          }
        }
      }
    },
    "%lld served today (inferred)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日经手 %lld 次（推断）"
          }
        }
      }
    },
    "%lld today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日 %lld 次"
          }
        }
      }
    },
    "%lld without a price": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条无价格"
          }
        }
      }
    },
    "1 active tunnel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 条活跃隧道"
          }
        }
      }
    },
    "1 consecutive failure": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
